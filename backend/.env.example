# Konfigurasi Aplikasi
APP_ENV=development
APP_PORT=8080
APP_SECRET=your-app-secret-key

# Konfigurasi Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qurban_db
DB_SSL_MODE=disable

# Konfigurasi Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Konfigurasi JWT
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY_HOUR=24
JWT_REFRESH_EXPIRY_DAY=7
